// Sephraxia — Prisma schema
// SQLite has no native enum support, so `status` and `type` are stored as
// strings constrained by the shared TypeScript union types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  uid          Int?     @unique // sequential public id (1, 2, 3…); seniority marker
  username     String   @unique // the @handle
  displayName  String? // chosen display name; falls back to username
  passwordHash String
  avatarUrl    String?
  bannerUrl    String? // profile banner image (png/jpg/gif)
  bio          String? // short "about me" shown on the profile card
  status       String   @default("offline") // online | idle | dnd | offline
  isOwner      Boolean  @default(false) // bypasses all permission checks

  // Cosmetics
  accentColor String? // custom profile accent (overrides role colour on own profile)
  cheats      String  @default("") // csv of project keys: skeet,neverlose,fatality,…
  links       String? // JSON [{label,url}] — e.g. links to HVH profiles
  profileCfg  String? // JSON profile-card config (shown cells, banner mode, etc.)
  // Admin-granted prefix badge (separate from self-customization)
  badge       String? // short text shown before the name, e.g. "root" / "dev"
  badgeColor  String? // hex colour for the badge
  createdAt    DateTime @default(now())

  // Moderation state (global; this is a single-community server)
  bannedAt     DateTime? // non-null = banned (cannot log in / connect)
  bannedReason String?
  mutedUntil   DateTime? // timeout: cannot send messages until this time

  messages         Message[]
  sentMessages     DirectMessage[] @relation("SentDirectMessages")
  receivedMessages DirectMessage[] @relation("ReceivedDirectMessages")
  roles            Role[]          @relation("UserRoles")

  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  ownedServers      Server[]       @relation("OwnedServers")
  serverMemberships ServerMember[]
  configPosts       ConfigPost[]
}

// A community ("guild"): owns channels and has explicit members. The original
// single community becomes the seeded "home" server (see ensureHomeServer).
model Server {
  id         String   @id @default(cuid())
  name       String
  icon       String? // short emoji/symbol shown in the rail
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  ownerId String
  owner   User   @relation("OwnedServers", fields: [ownerId], references: [id], onDelete: Cascade)

  members  ServerMember[]
  channels Channel[]
  roles    Role[]
}

model ServerMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
}

model Channel {
  id       String  @id @default(cuid())
  name     String
  topic    String? // short description shown in the chat header
  type     String  @default("text") // text | voice
  position Int     @default(0)

  // Nullable only for migration safety; backfilled to the home server at boot.
  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([serverId, position])
}

model Message {
  id          String    @id @default(cuid())
  content     String
  attachments String? // JSON-encoded Attachment[] (SQLite has no JSON column)
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  pinned      Boolean   @default(false)
  pinnedAt    DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // Optional reply to another message in the same channel.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions Reaction[]

  @@index([channelId, createdAt])
  @@index([channelId, pinned])
}

// One emoji reaction by one user on one channel message.
model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  userId String
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model DirectMessage {
  id          String    @id @default(cuid())
  content     String
  attachments String? // JSON-encoded Attachment[]
  createdAt   DateTime  @default(now())
  editedAt    DateTime?

  fromId String
  from   User   @relation("SentDirectMessages", fields: [fromId], references: [id], onDelete: Cascade)

  toId String
  to   User   @relation("ReceivedDirectMessages", fields: [toId], references: [id], onDelete: Cascade)

  replyToId String?
  replyTo   DirectMessage?  @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   DirectMessage[] @relation("DmReplies")

  reactions DmReaction[]

  @@index([fromId, toId, createdAt])
}

// One emoji reaction by one user on one direct message.
model DmReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  userId String
  dmId   String
  dm     DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)

  @@unique([dmId, userId, emoji])
  @@index([dmId])
}

model Role {
  id       String @id @default(cuid())
  name     String
  color    String
  symbol   String
  position Int    @default(0)

  // Roles belong to a server (nullable only for migration; backfilled to home).
  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // Permissions
  canManageChannels Boolean @default(false)
  canDeleteMessages Boolean @default(false)
  canManageRoles    Boolean @default(false)
  canKick           Boolean @default(false)
  canBan            Boolean @default(false)
  canTimeout        Boolean @default(false)

  users User[] @relation("UserRoles")

  @@index([serverId])
}

// A shareable cheat config / lua script in the library, tagged by project.
model ConfigPost {
  id          String   @id @default(cuid())
  title       String
  project     String // neverlose | skeet | other
  category    String   @default("config") // config | lua | other
  description String?
  tags        String   @default("") // comma-separated
  fileUrl     String // /uploads/<file>
  fileName    String
  fileSize    Int
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([project, createdAt])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}
