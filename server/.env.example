# Copy to .env and fill in. NEVER commit the real .env (it holds secrets).
DATABASE_URL="file:./dev.db"

# Generate long random strings (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
# "*" allows any origin (auth is via JWT Bearer, not cookies).
CLIENT_ORIGIN="*"
# Public base URL — not required now that uploads use relative paths.
# SERVER_PUBLIC_URL="https://your-name.cloudpub.ru"
