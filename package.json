{
  "name": "sephraxia",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted desktop messenger with a dark glass aesthetic",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
